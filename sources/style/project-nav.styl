.project-nav
    position fixed
    top 20px
    left 50%
    transform translateX(-50%)
    display flex
    gap 20px
    z-index 10
    pointer-events none
    opacity 0
    transition opacity 0.5s

    &.is-visible
        opacity 1
        pointer-events auto

.project-nav-button
    width 40px
    height 40px
    border-radius 50%
    background rgba(0, 0, 0, 0.5)
    border 1px solid rgba(255, 255, 255, 0.2)
    cursor pointer
    display flex
    justify-content center
    align-items center

    &::before
        content ''
        display block
        width 10px
        height 10px
        border-left 2px solid white
        border-bottom 2px solid white

.project-nav-button-previous::before
    transform rotate(45deg)

.project-nav-button-next::before
    transform rotate(-135deg)

.project-nav-button-close::before
    content 'X'
    border none
    font-size 20px
    color white
