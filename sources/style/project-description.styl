.project-description
    position fixed
    bottom 0
    left 50%
    transform translateX(-50%) translateY(110%)
    width min(580px, 88vw)
    max-height 45vh
    background rgba(16, 10, 24, 0.94)
    border 1px solid rgba(147, 147, 213, 0.35)
    border-top-left-radius 14px
    border-top-right-radius 14px
    padding 18px 22px 24px
    z-index 9
    transition transform 0.45s cubic-bezier(0.22, 0.61, 0.36, 1)
    backdrop-filter blur(10px)
    pointer-events none
    overflow hidden
    box-sizing border-box

    &.is-visible
        transform translateX(-50%) translateY(0)
        pointer-events auto

.project-description-inner
    overflow-y auto
    max-height calc(45vh - 40px)

    &::-webkit-scrollbar
        width 4px

    &::-webkit-scrollbar-track
        background transparent

    &::-webkit-scrollbar-thumb
        background rgba(147, 147, 213, 0.4)
        border-radius 2px

.project-description-text
    color rgba(255, 255, 255, 0.88)
    font-family "Nunito", sans-serif
    font-size 14px
    line-height 1.75
    margin 0

.project-description-link
    color #b3b3ff
    text-decoration none
    border-bottom 1px solid rgba(147, 147, 213, 0.4)
    transition color 0.2s, border-color 0.2s

    &:hover
        color #fff
        border-bottom-color rgba(147, 147, 213, 0.8)

.shiny-link
    font-weight 700
    background linear-gradient(90deg, #9393d5, #d4a5ff, #9393d5)
    background-size 200% auto
    -webkit-background-clip text
    -webkit-text-fill-color transparent
    background-clip text
    animation shine 3s linear infinite
    cursor pointer
    text-decoration none

@keyframes shine
    to
        background-position 200% center

.replit-badge
    display none !important
